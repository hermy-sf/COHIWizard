# Makefile.win – Windows/MSYS2 MinGW64 build of the shared DSP libraries used by several dev_drivers
#
#   libdspfl2k.dll   (DspWorkerFL2K)
#   libdspflmod.dll  (DspWorkerFLMod)
#
# liquidDSP-free – only needs osmo-fl2k. Run from an MSYS2 MinGW64
# shell (MSYSTEM=MINGW64), with osmo-fl2k built and installed into the
# MinGW64 prefix. Default prefix is /mingw64.
#
# Usage:
#   make -f Makefile.win          – build both DLLs
#   make -f Makefile.win clean    – remove build artefacts

MINGW_PREFIX ?= /mingw64

CXX      := g++
CXXFLAGS := -std=c++17 -O3 -march=native -ffast-math -I$(MINGW_PREFIX)/include
LDFLAGS  := -shared -static-libgcc -static-libstdc++ -L$(MINGW_PREFIX)/lib
LDLIBS   := -losmo-fl2k -lpthread -lm -lws2_32
TARGETS  := libdspfl2k.dll libdspflmod.dll

all: $(TARGETS)
	@echo "Runtime deps (keep in this directory): libosmo-fl2k.dll, libusb-1.0.dll, libwinpthread-1.dll."

libdspfl2k.dll: DspWorkerFL2K.cpp DspWorkerFL2K.h
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $< $(LDLIBS)

libdspflmod.dll: DspWorkerFLMod.cpp DspWorkerFLMod.h
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $< $(LDLIBS)

clean:
	rm -f $(TARGETS)

.PHONY: all clean
